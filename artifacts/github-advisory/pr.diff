+    request = GitHubPublishRequest(
+        owner_repo=owner_repo,
+        pr_number=pr_number,
+        head_sha=head_sha,
+        response=response,
+        changed_lines={key: sorted(value) for key, value in changed_lines.items()},
+        dry_run=effective_dry_run,
+    )
+    client: GitHubPublisherClient
+    if effective_dry_run:
