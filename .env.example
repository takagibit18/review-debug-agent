# OpenAI API configuration
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o
MODEL_PROVIDER=
# GitHub API (crawler / eval.run crawl). Use a classic PAT or fine-grained PAT with
# "Contents: Read" on target repos and search scope as needed. Also accepted: GH_TOKEN, github_token.
# On Windows, remove any empty/stale GITHUB_TOKEN from User/System env — it used to override .env.
GITHUB_TOKEN=ghp_your_token_for_crawler
# Advisory publishing from GitHub Actions needs pull-requests:write and checks:write.
# Dry-run remains the default unless CLI --publish is passed or this is set to false.
GITHUB_ADVISORY_DRY_RUN=true
GITHUB_ADVISORY_COMMENT_MARKER=<!-- mergewarden:comment -->

# GitHub auth mode. Keep "token" for the existing GitHub Token / Actions flow.
# Set "app" for the webhook-driven GitHub App deployment mode.
GITHUB_AUTH_MODE=token
# Equivalent app-mode switch, useful for platforms that prefer booleans.
GITHUB_APP_MODE=false
# GitHub App settings used only when GITHUB_AUTH_MODE=app.
GITHUB_APP_ID=
# Paste the PEM as one line with literal \n sequences, or as a normal multiline
# env var if your deployment platform supports it.
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Public backend URL used when configuring the GitHub App webhook.
APP_BASE_URL=http://localhost:8000
# PUBLIC_URL is accepted as a fallback for APP_BASE_URL.
# PUBLIC_URL=
GITHUB_REVIEW_DRAFT_PRS=false
# Keep false in production unless you intentionally want manual reruns to
# duplicate delivery/head processing.
GITHUB_WEBHOOK_ALLOW_RERUN=false

# Platform MVP persistence and worker settings.
PLATFORM_DATABASE_URL=sqlite:///.mergewarden/platform.db
PLATFORM_ARTIFACT_ROOT=.mergewarden/platform-artifacts
PLATFORM_INIT_DB_ON_STARTUP=true
PLATFORM_PUBLIC_GITHUB_APP_ONLY=false
PLATFORM_REVIEW_ENABLED=true
PLATFORM_PUBLISH_COMMENTS=true
# Optional local/dev fallback for /platform/* management APIs when the
# X-MergeWarden-Tenant header is omitted. Leave empty in shared environments.
PLATFORM_DEFAULT_TENANT_ID=
PLATFORM_WORKER_POLL_INTERVAL_SECONDS=2.0
PLATFORM_WORKER_SINGLE_WORKER=true

# Docker Compose hosted runtime overrides these values so the API and worker
# share durable state in the named /data volume:
# PLATFORM_DATABASE_URL=sqlite:////data/platform.db
# PLATFORM_ARTIFACT_ROOT=/data/platform-artifacts
# EVENT_LOG_DIR=/data/logs
# PLATFORM_PUBLIC_GITHUB_APP_ONLY=true

# Logging
LOG_LEVEL=INFO

# FastAPI (optional local server; no extra required env vars)
# uvicorn src.api.app:app --reload

# Orchestrator (optional; defaults match Settings)
# REVIEW_MAX_ITERATIONS=1
# DEBUG_MAX_ITERATIONS=3
# TOKEN_BUDGET=30000         # Soft cap stops exploration and triggers finalize-only.
# TOKEN_HARD_BUDGET=36000
# FINAL_SUBMIT_RESERVE_TOKENS=12000
# FINAL_SUBMIT_PROMPT_TOKEN_BUDGET=4000
# FINAL_SUBMIT_FEEDBACK_TOKEN_BUDGET=1200  # Included within the 4000-token prompt budget.
# FEEDBACK_WINDOW_ITERATIONS=3  # Recent iterations of tool feedback injected verbatim.
# PROMPT_INPUT_TOKEN_BUDGET=32000
# MODEL_REQUEST_TIMEOUT_SECONDS=60
# MODEL_MAX_RETRIES=1
# AGENT_RUN_TIMEOUT_SECONDS=170
# AGENT_TOOL_TIMEOUT_SECONDS=30
# EVENT_LOG_DIR=.mergewarden/logs
# ROOT_CAUSE_CONSOLIDATION_ENABLED=true
# ROOT_CAUSE_CONSOLIDATION_MAX_BLOCK_SIZE=16
# ROOT_CAUSE_CONSOLIDATION_CONSERVATIVE_MODE=true
# ROOT_CAUSE_CONSOLIDATION_EXTRA_RETRIEVAL_ENABLED=false
# RELATION_GRAPH_ENABLED=true
# RELATION_GRAPH_PERSISTENCE_ENABLED=true
# RELATION_GRAPH_INDEX_PATH=.mergewarden/relation-index.sqlite3
# RELATION_GRAPH_MAX_DEPTH=2
# RELATION_GRAPH_MAX_NODES=40
# RELATION_GRAPH_MAX_CONTEXT_TOKENS=4000
# RELATION_GRAPH_MIN_EVIDENCE_CONFIDENCE=0.65
# RELATION_GRAPH_LSP_ENRICHMENT_ENABLED=false
# RELATION_GRAPH_RESOLVER_MODE=ast
# RELATION_GRAPH_MAX_FILES=5000
# RELATION_GRAPH_MAX_AMBIGUOUS_TARGETS=4
#
# Agent trace logging (optional; see docs/agent_trace_logging.md)
# AGENT_TRACE_DETAIL=off
# AGENT_TRACE_MAX_CHARS=1200
# AGENT_TRACE_LOG_TOOL_BODY=false
# EVAL_TEMPERATURE=0.0
# EVAL_SAMPLES=1
# EVAL_CONCURRENCY=1
# EVAL_GIT_TIMEOUT_SECONDS=120
#
# Execute tools (optional; debug mode only, still gated by high-risk confirmation)
# EXECUTE_ENABLED=true
# EXECUTE_BACKEND=subprocess
# EXECUTE_ALLOWED_COMMANDS=python,pytest,pip,node,npm,ruff,mypy,git
# EXECUTE_DEFAULT_TIMEOUT_MS=30000
# EXECUTE_MAX_OUTPUT_BYTES=65536
#
# Docker execute backend (build Dockerfile.execute first)
# EXECUTE_DOCKER_IMAGE=mergewarden-execute:latest
# EXECUTE_DOCKER_WORKDIR=/workspace
# EXECUTE_DOCKER_NETWORK=none
# EXECUTE_DOCKER_MEMORY_MB=0
# EXECUTE_DOCKER_CPUS=0
#
# Optional smoke tests
# RUN_DOCKER_TESTS=0
# CI=0
